# --- LLM used to parse the natural-language edit instruction ---
# provider: "anthropic" | "openai" | "gemini" | "none"
# "none" (or any provider with no key set) falls back to a deterministic
# regex/keyword parser so the app runs fully offline.
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# --- Optional: text-to-image generation for "replace" when no reference
# image is uploaded. Currently supports OpenAI Images API. Leave blank to
# fall back to a generated placeholder graphic instead. ---
IMAGE_GEN_PROVIDER=none
OPENAI_IMAGE_MODEL=gpt-image-1

# --- Video processing limits (keep small for a CPU-only demo) ---
MAX_VIDEO_SECONDS=20
PROCESS_MAX_WIDTH=640
YOLO_SEG_MODEL=yolov8n-seg.pt
YOLO_CONF_THRESHOLD=0.25

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
